# Base URL of the Claims Business API (see ../claims-api-openapi.yaml).
# Defaults to this POC's local mock-api service (see ../mock-api/) so the
# stack is runnable with no real carrier system. Point this at a real
# Claims API base URL to move off the mock.
CLAIMS_API_BASE_URL=http://localhost:4000

# Bearer token sent to the Claims API. The mock-api accepts any non-empty
# value. In production, fetch/refresh a real OAuth2 client-credentials
# access token instead of hardcoding one here.
CLAIMS_API_TOKEN=mock-dev-token

# Request timeout in milliseconds
CLAIMS_API_TIMEOUT_MS=30000

# "stdio" for local/desktop MCP clients, "http" for remote/multi-client deployment
TRANSPORT=http

# Only used when TRANSPORT=http
PORT=3000
