# AI — optional; app runs in fallback/demo mode without it
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Database
DATABASE_URL=sqlite:///./db/app.db

# App
APP_ENV=development

# Cache TTL in hours (default 24)
CACHE_TTL_HOURS=24

# Rate limiting: max requests per minute per IP on POST /demo/run
RATE_LIMIT_PER_MINUTE=10

# CORS origins — comma-separated (no spaces)
# In production, replace with your actual domain
ALLOWED_ORIGINS=http://localhost:8010,http://localhost:3000
